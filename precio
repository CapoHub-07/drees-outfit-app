<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Detalle del Producto</title>
  <!-- Tailwind CSS para que se vea moderno y ordenado -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- SDK oficial de Supabase -->
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
</head>
<body class="bg-slate-900 text-white flex items-center justify-center min-h-screen p-4">

  <div class="bg-slate-800 p-6 rounded-2xl shadow-xl max-w-sm w-full text-center border border-slate-700">
    <span class="text-xs uppercase tracking-widest text-emerald-400 font-semibold bg-emerald-950/50 px-3 py-1 rounded-full border border-emerald-800/50">Catálogo en Línea</span>
    
    <h2 class="text-2xl font-bold text-white mt-4 mb-2" id="prod-nombre">Cargando producto...</h2>
    <p class="text-slate-300 text-sm mb-6" id="prod-info">Por favor espere un momento</p>
    
    <div class="bg-slate-900/60 p-4 rounded-xl border border-slate-700/50 mb-4">
      <div class="text-xs text-slate-400 mb-1">Precio Actualizado</div>
      <div class="text-3xl font-extrabold text-amber-400" id="prod-precio">$0</div>
    </div>

    <div class="text-xs text-slate-400" id="prod-unidad">Presentación: -</div>
  </div>

  <script>
    // ⚠️ REEMPLAZA ESTAS CREDENCIALES con las mismas de tu proyecto de Supabase
    const SUPABASE_URL = 'https://zzmojfukciqbxrjnmdeo.supabase.co';
    const SUPABASE_ANON_KEY = 'sb_publishable_m6UEIb277hu0TvPTnFaGyg_FzFiKixX';
    
    const _supabase = supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

    async function cargarDatosProducto() {
      // 1. Lee el ID que viaja en la URL (ej: producto.html?id=123...)
      const params = new URLSearchParams(window.location.search);
      const productoId = params.get('id');

      if (!productoId) {
        document.getElementById('prod-nombre').innerText = "Producto no encontrado";
        document.getElementById('prod-info').innerText = "El código QR escaneado no es válido.";
        return;
      }

      // 2. Consulta los datos frescos en tu tabla de Supabase
      const { data, error } = await _supabase
        .from('productos')
        .select('*')
        .eq('id', productoId)
        .single();

      if (error || !data) {
        document.getElementById('prod-nombre').innerText = "Sin disponibilidad";
        document.getElementById('prod-info').innerText = "Este artículo ya no se encuentra activo en el sistema.";
        return;
      }

      // 3. Muestra la información en la pantalla del celular del cliente
      document.getElementById('prod-nombre').innerText = data.nombre;
      document.getElementById('prod-info').innerText = data.info_extra || 'Sin información adicional';
      document.getElementById('prod-precio').innerText = `$${Number(data.precio_venta).toLocaleString()}`;
      document.getElementById('prod-unidad').innerText = `Presentación / Unidad: ${data.unidad || 'unidad'}`;
    }

    cargarDatosProducto();
  </script>
</body>
</html>
